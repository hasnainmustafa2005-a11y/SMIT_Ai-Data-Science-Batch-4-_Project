    {
      "parameters": {
        "jsCode": "const matches = $json.matches || [];\nconst topScore = matches.length > 0 ? matches[0].score : 0;\nconst context = matches.map(m => (m.metadata ? m.metadata.text : '')).join('\\n\\n');\nconst original = $('Parse Inbound Email').first().json;\n\nconst query = original.customer_query.toLowerCase();\nconst isHighRisk = query.includes('fraud hold') || query.includes('unfreeze') || query.includes('dispute') || query.includes('chargeback');\nconst isConfident = topScore >= 0.70 && context.trim().length > 0;\n\nreturn [{\n  json: {\n    sender_email: original.sender_email,\n    subject: original.subject,\n    customer_query: original.customer_query,\n    retrieved_context: isConfident ? context : 'INSUFFICIENT_INFORMATION',\n    top_score: topScore,\n    requires_human_approval: isHighRisk || !isConfident\n  }\n}];"
      },
