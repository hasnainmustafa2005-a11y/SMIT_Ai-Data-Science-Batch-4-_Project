    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\nlet sender = '';\nif (typeof email.from === 'string') {\n  sender = email.from;\n} else if (email.from?.text) {\n  sender = email.from.text;\n} else if (email.from?.value?.[0]?.address) {\n  sender = email.from.value[0].address;\n} else if (email.headers?.from) {\n  sender = email.headers.from;\n}\nsender = String(sender || '');\nconst match = sender.match(/<([^>]+)>/);\nconst senderEmail = match ? match[1].trim() : (sender.trim() || 'customer@example.com');\n\nreturn [{\n  json: {\n    sender_email: senderEmail,\n    subject: String(email.subject || email.headers?.subject || 'Support Query'),\n    customer_query: String(email.snippet || email.textPlain || email.subject || '').trim(),\n    message_id: email.id || email.messageId || ''\n  }\n}];"
      },
