    {
      "parameters": {
        "jsCode": "const parent = $('Split SO').item.json;\nconst mems = $input.all();\nconst out = [];\nfor (const m of mems) {\n  const h = m.json.account_holders;\n  if (!h || !h.email) continue;\n  out.push({\n    json: {\n      account_id: parent.source_account_id,\n      event_type: 'standing_order_failed',\n      recipient_email: h.email,\n      payload: {\n        standing_order_id: parent.id,\n        amount: parent.amount,\n        currency: 'USD',\n        reason: 'standing order permanently failed',\n        failed_date: new Date().toISOString().slice(0, 10),\n        retry_count: 0,\n        holder_name: h.full_name\n      }\n    }\n  });\n}\nif (out.length === 0) {\n  return [{ json: { _warning: 'no_holders_with_email', account_id: parent.source_account_id, standing_order_id: parent.id } }];\n}\nreturn out;"
      },
