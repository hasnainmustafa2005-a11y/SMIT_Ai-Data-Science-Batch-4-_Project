    {
      "parameters": {
        "jsCode": "const input = $input.all();\nif (input.length === 1) {\n  const first = input[0].json;\n  if (Array.isArray(first)) return first.map(row => ({ json: row }));\n  if (typeof first === 'object' && first !== null && !first.standing_order_id) {\n    const keys = Object.keys(first);\n    if (keys.every(k => /^\\d+$/.test(k))) return keys.map(k => ({ json: first[k] }));\n  }\n}\nreturn input.map(i => ({ json: i.json }));"
      },
