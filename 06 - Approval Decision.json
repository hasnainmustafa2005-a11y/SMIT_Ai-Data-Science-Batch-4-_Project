        "jsCode": "return [{\n  json: {\n    html: `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Approved</title><style>body{font-family:sans-serif;max-width:600px;margin:80px auto;padding:20px;text-align:center;color:#111}h1{color:#0a7d32}.box{border:1px solid #e0e0e0;border-radius:8px;padding:24px;margin-top:20px;background:#f9fff9}p{margin:8px 0}</style></head><body><h1>Approved and Sent</h1><div class=\"box\"><p>The support response has been approved and delivered to the customer.</p><p><strong>Approval ID:</strong> ${$json.approval_id}</p><p><strong>Customer:</strong> ${$json.payload.recipient}</p><p>You may now close this tab.</p></div></body></html>`,\n    status: 'APPROVED_SENT'\n  }\n}];"
