        "jsCode": "const q = $json.query || {};\nconst token = String(q.token || '').trim();\nif (!token) {\n  return [{ json: { _error: 'MISSING_TOKEN' } }];\n}\nreturn [{ json: { token, hmac_secret: $vars.HMAC_SECRET } }];"
