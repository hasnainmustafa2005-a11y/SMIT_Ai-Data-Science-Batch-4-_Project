    {
      "parameters": {
        "jsCode": "let payload = $json;\nif (typeof payload === 'string') { try { payload = JSON.parse(payload); } catch (e) {} }\nconst row = Array.isArray(payload) ? payload[0] : payload;\nif (!row || !row.approval_id || !row.decision) {\n  return [{ json: { valid: false, reason: 'malformed_verify_response', approval_id: null, decision: null } }];\n}\nreturn [{ json: { valid: row.is_valid === true || row.is_valid === 'true', reason: row.reason || 'unknown', approval_id: row.approval_id, decision: row.decision } }];"
      },
