        "jsCode": "const reason = $json.reason || 'unknown';\nconst friendly = reason === 'expired' ? 'This approval link has expired.'\n  : reason === 'bad_signature' ? 'This approval link is not valid (signature mismatch).'\n  : reason === 'malformed_token' ? 'This approval link is malformed.'\n  : 'This approval link could not be verified.';\nreturn [{\n  json: {\n    html: `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Invalid</title><style>body{font-family:sans-serif;max-width:600px;margin:80px auto;padding:20px;text-align:center;color:#111}h1{color:#a02020}.box{border:1px solid #e0e0e0;border-radius:8px;padding:24px;margin-top:20px;background:#fff9f9}p{margin:8px 0}</style></head><body><h1>Link Not Valid</h1><div class=\"box\"><p>${friendly}</p><p><strong>Reason:</strong> ${reason}</p><p>No action was taken.</p></div></body></html>`,\n    status: 'INVALID'\n  }\n}];"
      },
