      ],
      "webhookId": "banking-api"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst operation = String(body.operation || '').toLowerCase();\nconst amount = Number(body.amount);\n\nif (!['deposit', 'withdrawal', 'transfer'].includes(operation)) {\n  return [{ json: { success: false, error: 'INVALID_OPERATION', message: 'operation must be deposit, withdrawal, or transfer' } }];\n}\nif (!Number.isFinite(amount) || amount <= 0) {\n  return [{ json: { success: false, error: 'INVALID_AMOUNT', message: 'amount must be a positive number' } }];\n}\nif (!body.idempotency_key) {\n  return [{ json: { success: false, error: 'MISSING_IDEMPOTENCY_KEY', message: 'idempotency_key is required' } }];\n}\nif (!body.account_id && operation !== 'transfer') {\n  return [{ json: { success: false, error: 'MISSING_ACCOUNT_ID', message: 'account_id is required' } }];\n}\nif (operation === 'transfer' && (!body.source_account_id || !body.destination_account_id)) {\n  return [{ json: { success: false, error: 'MISSING_TRANSFER_ACCOUNTS', message: 'source_account_id and destination_account_id are required for transfer' } }];\n}\nif (!body.currency) {\n  return [{ json: { success: false, error: 'MISSING_CURRENCY', message: 'currency is required' } }];\n}\n\nreturn [{\n  json: {\n    operation,\n    idempotency_key: String(body.idempotency_key),\n    account_id: body.account_id || null,\n    source_account_id: body.source_account_id || null,\n    destination_account_id: body.destination_account_id || null,\n    amount,\n    currency: String(body.currency).toUpperCase(),\n    transaction_type: body.transaction_type || 'transfer',\n    description: body.description || 'Banking API transaction'\n  }\n}];"
      },
      "id": "6de4d02f-f134-4813-b235-40b906732b2a",
