{
  "name": "01 - Banking API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "banking",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "146ef756-4db8-423c-bf6a-23211e4b5269",
      "name": "Banking API Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
